# ============================================================
# .dockerignore —— 控制传给 Docker 构建上下文的文件
# 缩小上下文 = 更快构建 + 更稳缓存命中 + 避免把敏感/环境数据烤进镜像
# ============================================================

# 依赖（容器内重新 npm install，避免平台不匹配）
node_modules/
**/node_modules/

# 构建产物（容器内重新 vite build）
dist/
**/dist/

# 运行时数据（绝不能进镜像 —— 每次部署都不同，且含用户数据/会话）
.data/
**/.data/

# Git
.git/
.gitignore
.gitattributes

# 认证 / 本地配置（含 API token，必须运行时注入，不能烤进镜像）
.claude/setting.agent.json
.claude/setting.agent.ds.json
.claude/settings.local.json
.env
.env.local
.env.*
**/.env
**/.env.local

# 临时 / 验证产物
*.log
.playwright-mcp/
export-button.png
new-default-config.png
verification-old-project.png

# Docker 自身（不需要进上下文）
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# IDE / OS
.vscode/
.idea/
.DS_Store
**/.DS_Store

# 文档（可选，减少上下文；如需镜像内带文档则移除此行）
docs/
