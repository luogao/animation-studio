# ============================================================
# .env.example — docker compose 环境变量样板
# 用法：cp .env.example .env，按需修改后 docker compose up -d --build
# 注意：LLM 配置默认在浏览器 UI 里填（首次启动后），不需要在这里设。
# ============================================================

# 宿主机对外暴露端口（左侧）；容器内固定 5174
PORT=5174

# 可选：覆盖 agent 使用的模型 id（留空则用 UI 里配置的模型）
# CLAUDE_MODEL=deepseek-v4-pro
